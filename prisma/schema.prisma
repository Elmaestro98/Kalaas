generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Listes de choix ───────────────────────────────

enum Role {
  DIRECTEUR
  CAISSIER
  FORMATEUR
}

enum StatutInstitut {
  ACTIF
  SUSPENDU
}

enum Offre {
  ESSENTIEL
  PRO
  PREMIUM
  CAMPUS
}

enum CycleFormation {
  FORMATION_COURTE
  LICENCE
  MASTER
  DOCTORAT
}

enum TypeInscription {
  NOUVELLE
  REINSCRIPTION
  REDOUBLEMENT
}

enum Sexe {
  F
  M
}

enum StatutAbonnement {
  ESSAI
  ACTIF
  EXPIRE
  ANNULE
}

enum StatutInscription {
  ACTIVE
  ABANDON
  TERMINEE
  TRANSFEREE
}

enum TypeRemise {
  MONTANT
  POURCENTAGE
}

enum TypeEcheance {
  INSCRIPTION
  MENSUALITE
}

enum StatutEcheance {
  A_PAYER
  PARTIEL
  PAYEE
  ANNULEE
}

enum ModePaiement {
  ESPECES
  WAVE
  ORANGE_MONEY
  VIREMENT
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  EXCUSE
}

enum CanalRelance {
  WHATSAPP
  SMS
}

enum DeclencheurRelance {
  MANUELLE
  J_MOINS_3
  J_PLUS_1
  J_PLUS_7
}

enum StatutRelance {
  A_ENVOYER
  ENVOYEE
  ECHEC
}

enum StatutJob {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ECHEC
}

enum StatutInvitation {
  EN_ATTENTE
  ACCEPTEE
  REVOQUEE
}

enum StatutEnseignant {
  PERMANENT
  VACATAIRE
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

// ─── Plateforme : instituts, comptes, rôles ────────

model Institut {
  id               String         @id @default(cuid())
  clerkOrgId       String         @unique
  nom              String
  logoUrl          String?
  adresse          String?
  ville            String?
  ninea            String?
  rccm             String?
  telephone        String?
  telephone2       String?
  sousDomaine      String?        @unique
  piedRecu         String?
  prefixeMatricule String?
  statut           StatutInstitut @default(ACTIF)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  abonnements        Abonnement[]
  membres            Membre[]
  formations         Formation[]
  sessions           Session[]
  apprenants         Apprenant[]
  inscriptions       Inscription[]
  echeances          Echeance[]
  paiements          Paiement[]
  repartitions       PaiementEcheance[]
  annulations        Annulation[]
  compteursRecu      CompteurRecu[]
  cloturesCaisse     ClotureCaisse[]
  seances            Seance[]
  presences          Presence[]
  modelesRelance     ModeleRelance[]
  relances           Relance[]
  journalAudit       JournalAudit[]
  jobs               Job[]
  anneesAcademiques  AnneeAcademique[]
  compteursMatricule CompteurMatricule[]
  salles             Salle[]
  creneaux           Creneau[]
  enseignants        Enseignant[]
  affectations       Affectation[]
  invitations        Invitation[]
}

model Abonnement {
  id         String           @id @default(cuid())
  institutId String
  offre      Offre
  statut     StatutAbonnement @default(ESSAI)
  debut      DateTime
  fin        DateTime
  createdAt  DateTime         @default(now())

  institut Institut @relation(fields: [institutId], references: [id])

  @@index([institutId])
}

model Utilisateur {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  nom         String
  superAdmin  Boolean  @default(false)
  createdAt   DateTime @default(now())

  membres      Membre[]
  journalAudit JournalAudit[]
}

model Membre {
  id            String   @id @default(cuid())
  institutId    String
  utilisateurId String
  role          Role
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())

  institut    Institut    @relation(fields: [institutId], references: [id])
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  sessionsAnimees    Session[]
  paiementsEncaisses Paiement[]
  annulations        Annulation[]
  cloturesCaisse     ClotureCaisse[]
  relancesEnvoyees   Relance[]
  ficheEnseignant    Enseignant?
  appels             Seance[]

  @@unique([institutId, utilisateurId])
  @@index([utilisateurId])
}

// ─── Catalogue : années, formations et sessions ────

// Année académique LMD (ex. 2026-2027, d'octobre à juillet)
model AnneeAcademique {
  id         String   @id @default(cuid())
  institutId String
  libelle    String
  dateDebut  DateTime @db.Date
  dateFin    DateTime @db.Date
  enCours    Boolean  @default(false)
  createdAt  DateTime @default(now())

  institut Institut  @relation(fields: [institutId], references: [id])
  sessions Session[]

  @@unique([institutId, libelle])
}

// En LMD, une formation = un niveau d'une filière (ex. Licence Informatique — L2)
model Formation {
  id               String         @id @default(cuid())
  institutId       String
  intitule         String
  cycle            CycleFormation @default(FORMATION_COURTE)
  filiere          String?
  niveau           Int?
  dureeMois        Int
  fraisInscription Int
  prixTotal        Int
  nbMensualites    Int
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  institut Institut  @relation(fields: [institutId], references: [id])
  sessions Session[]

  @@index([institutId])
  @@index([institutId, cycle, filiere, niveau])
}

model Session {
  id                String   @id @default(cuid())
  institutId        String
  formationId       String
  formateurId       String?
  anneeAcademiqueId String?
  nom               String
  dateDebut         DateTime @db.Date
  dateFin           DateTime @db.Date
  horaires          String?
  capacite          Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  institut        Institut         @relation(fields: [institutId], references: [id])
  formation       Formation        @relation(fields: [formationId], references: [id])
  formateur       Membre?          @relation(fields: [formateurId], references: [id])
  anneeAcademique AnneeAcademique? @relation(fields: [anneeAcademiqueId], references: [id])
  inscriptions    Inscription[]
  seances         Seance[]
  creneaux        Creneau[]
  affectations    Affectation[]

  @@index([institutId])
  @@index([formationId])
  @@index([formateurId])
  @@index([anneeAcademiqueId])
}

// ─── Emplois du temps (semaine type) ───────────────

// Professeur : une fiche, avec ou sans compte Kalaas (membreId facultatif)
model Enseignant {
  id           String           @id @default(cuid())
  institutId   String
  prenom       String
  nom          String
  telephone    String?
  email        String?
  specialite   String?
  statut       StatutEnseignant @default(VACATAIRE)
  tarifHoraire Int?
  membreId     String?          @unique
  actif        Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  institut     Institut      @relation(fields: [institutId], references: [id])
  membre       Membre?       @relation(fields: [membreId], references: [id])
  creneaux     Creneau[]
  affectations Affectation[]
  invitations  Invitation[]

  @@index([institutId, nom])
}

model Salle {
  id         String   @id @default(cuid())
  institutId String
  nom        String
  capacite   Int?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  institut Institut  @relation(fields: [institutId], references: [id])
  creneaux Creneau[]

  @@unique([institutId, nom])
}

// Un cours hebdomadaire d'une session : il se répète chaque semaine
// entre la date de début et la date de fin de la session.
// Les heures sont en minutes depuis minuit (8h30 → 510).
model Creneau {
  id           String      @id @default(cuid())
  institutId   String
  sessionId    String
  jour         JourSemaine
  heureDebut   Int
  heureFin     Int
  matiere      String
  enseignantId String?
  salleId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  institut   Institut    @relation(fields: [institutId], references: [id])
  session    Session     @relation(fields: [sessionId], references: [id])
  enseignant Enseignant? @relation(fields: [enseignantId], references: [id])
  salle      Salle?      @relation(fields: [salleId], references: [id])
  seances    Seance[]

  @@index([institutId, jour])
  @@index([sessionId])
  @@index([enseignantId])
  @@index([salleId])
}

// ─── Apprenants, inscriptions, échéancier ──────────

model Apprenant {
  id              String    @id @default(cuid())
  institutId      String
  matricule       String?
  prenom          String
  nom             String
  telephone       String
  email           String?
  dateNaissance   DateTime? @db.Date
  lieuNaissance   String?
  sexe            Sexe?
  diplomeAcces    String?
  pieceIdentite   String?
  tuteurNom       String?
  tuteurTelephone String?
  photoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  institut     Institut      @relation(fields: [institutId], references: [id])
  inscriptions Inscription[]
  paiements    Paiement[]

  @@unique([institutId, matricule])
  @@index([institutId, nom])
  @@index([institutId, telephone])
}

model Inscription {
  id                      String            @id @default(cuid())
  institutId              String
  apprenantId             String
  sessionId               String
  type                    TypeInscription   @default(NOUVELLE)
  inscriptionPrecedenteId String?
  date                    DateTime          @default(now())
  remiseType              TypeRemise?
  remiseValeur            Int               @default(0)
  motifRemise             String?
  statut                  StatutInscription @default(ACTIVE)
  dateSortie              DateTime?         @db.Date
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  institut   Institut      @relation(fields: [institutId], references: [id])
  apprenant  Apprenant     @relation(fields: [apprenantId], references: [id])
  session    Session       @relation(fields: [sessionId], references: [id])
  precedente Inscription?  @relation("Parcours", fields: [inscriptionPrecedenteId], references: [id])
  suivantes  Inscription[] @relation("Parcours")
  echeances  Echeance[]
  presences  Presence[]

  @@index([institutId])
  @@index([apprenantId])
  @@index([sessionId])
  @@index([inscriptionPrecedenteId])
}

model Echeance {
  id            String         @id @default(cuid())
  institutId    String
  inscriptionId String
  type          TypeEcheance
  libelle       String
  ordre         Int
  montantDu     Int
  montantPaye   Int            @default(0)
  dateLimite    DateTime       @db.Date
  statut        StatutEcheance @default(A_PAYER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  institut     Institut           @relation(fields: [institutId], references: [id])
  inscription  Inscription        @relation(fields: [inscriptionId], references: [id])
  repartitions PaiementEcheance[]
  relances     Relance[]

  @@index([institutId, statut, dateLimite])
  @@index([inscriptionId])
}

// ─── Paiements et caisse ───────────────────────────
// Un paiement n'est jamais modifié ni supprimé :
// une annulation crée une ligne Annulation.

model Paiement {
  id          String       @id @default(cuid())
  institutId  String
  apprenantId String
  caissierId  String?
  numeroRecu  String
  mode        ModePaiement
  montant     Int
  reference   String?
  note        String?
  date        DateTime     @default(now())
  createdAt   DateTime     @default(now())

  institut     Institut           @relation(fields: [institutId], references: [id])
  apprenant    Apprenant          @relation(fields: [apprenantId], references: [id])
  caissier     Membre?            @relation(fields: [caissierId], references: [id])
  repartitions PaiementEcheance[]
  annulation   Annulation?

  @@unique([institutId, numeroRecu])
  @@unique([mode, reference])
  @@index([institutId, date])
  @@index([apprenantId])
  @@index([caissierId, date])
}

model PaiementEcheance {
  id         String @id @default(cuid())
  institutId String
  paiementId String
  echeanceId String
  montant    Int

  institut Institut @relation(fields: [institutId], references: [id])
  paiement Paiement @relation(fields: [paiementId], references: [id])
  echeance Echeance @relation(fields: [echeanceId], references: [id])

  @@unique([paiementId, echeanceId])
  @@index([echeanceId])
  @@index([institutId])
}

model Annulation {
  id         String   @id @default(cuid())
  institutId String
  paiementId String   @unique
  auteurId   String
  motif      String
  date       DateTime @default(now())

  institut Institut @relation(fields: [institutId], references: [id])
  paiement Paiement @relation(fields: [paiementId], references: [id])
  auteur   Membre   @relation(fields: [auteurId], references: [id])

  @@index([institutId, date])
}

model CompteurRecu {
  institutId String
  annee      Int
  dernier    Int    @default(0)

  institut Institut @relation(fields: [institutId], references: [id])

  @@id([institutId, annee])
}

// Matricules étudiants : un compteur par établissement et par année d'entrée
model CompteurMatricule {
  institutId String
  annee      Int
  dernier    Int    @default(0)

  institut Institut @relation(fields: [institutId], references: [id])

  @@id([institutId, annee])
}

model ClotureCaisse {
  id               String   @id @default(cuid())
  institutId       String
  caissierId       String
  date             DateTime @db.Date
  montantTheorique Int
  montantCompte    Int
  ecart            Int
  commentaire      String?
  createdAt        DateTime @default(now())

  institut Institut @relation(fields: [institutId], references: [id])
  caissier Membre   @relation(fields: [caissierId], references: [id])

  @@unique([institutId, caissierId, date])
}

// ─── Présences ─────────────────────────────────────

// Un appel : un cours (créneau de l'emploi du temps) à une date donnée.
// Matière et horaires sont recopiés : l'historique reste juste même si
// le cours est ensuite modifié ou retiré de l'emploi du temps.
model Seance {
  id         String   @id @default(cuid())
  institutId String
  sessionId  String
  creneauId  String?
  date       DateTime @db.Date
  matiere    String?
  heureDebut Int?
  heureFin   Int?
  appelParId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  institut  Institut   @relation(fields: [institutId], references: [id])
  session   Session    @relation(fields: [sessionId], references: [id])
  creneau   Creneau?   @relation(fields: [creneauId], references: [id], onDelete: SetNull)
  appelPar  Membre?    @relation(fields: [appelParId], references: [id])
  presences Presence[]

  @@unique([sessionId, date, creneauId])
  @@index([institutId, date])
}

model Presence {
  id            String         @id @default(cuid())
  institutId    String
  seanceId      String
  inscriptionId String
  statut        StatutPresence

  institut    Institut    @relation(fields: [institutId], references: [id])
  seance      Seance      @relation(fields: [seanceId], references: [id])
  inscription Inscription @relation(fields: [inscriptionId], references: [id])

  @@unique([seanceId, inscriptionId])
  @@index([inscriptionId])
  @@index([institutId])
}

// ─── Relances ──────────────────────────────────────

model ModeleRelance {
  id          String             @id @default(cuid())
  institutId  String
  declencheur DeclencheurRelance
  canal       CanalRelance
  contenu     String
  actif       Boolean            @default(true)
  updatedAt   DateTime           @updatedAt

  institut Institut @relation(fields: [institutId], references: [id])

  @@unique([institutId, declencheur, canal])
}

model Relance {
  id          String             @id @default(cuid())
  institutId  String
  echeanceId  String
  auteurId    String?
  canal       CanalRelance
  declencheur DeclencheurRelance
  message     String
  statut      StatutRelance      @default(A_ENVOYER)
  envoyeeLe   DateTime?
  createdAt   DateTime           @default(now())

  institut Institut @relation(fields: [institutId], references: [id])
  echeance Echeance @relation(fields: [echeanceId], references: [id])
  auteur   Membre?  @relation(fields: [auteurId], references: [id])

  @@index([institutId, createdAt])
  @@index([echeanceId])
}

// ─── Traçabilité et tâches planifiées ──────────────

model JournalAudit {
  id         String   @id @default(cuid())
  institutId String?
  auteurId   String?
  action     String
  entite     String
  entiteId   String
  avant      Json?
  apres      Json?
  createdAt  DateTime @default(now())

  institut Institut?    @relation(fields: [institutId], references: [id])
  auteur   Utilisateur? @relation(fields: [auteurId], references: [id])

  @@index([institutId, createdAt])
  @@index([entite, entiteId])
}

model Job {
  id            String    @id @default(cuid())
  institutId    String?
  type          String
  payload       Json
  statut        StatutJob @default(EN_ATTENTE)
  tentatives    Int       @default(0)
  executerApres DateTime  @default(now())
  erreur        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institut Institut? @relation(fields: [institutId], references: [id])

  @@index([statut, executerApres])
}

// Une matière d'une classe, confiée à un professeur
model Affectation {
  id            String   @id @default(cuid())
  institutId    String
  sessionId     String
  enseignantId  String
  matiere       String
  volumeHoraire Int?
  createdAt     DateTime @default(now())

  institut   Institut   @relation(fields: [institutId], references: [id])
  session    Session    @relation(fields: [sessionId], references: [id])
  enseignant Enseignant @relation(fields: [enseignantId], references: [id])

  @@unique([sessionId, matiere])
  @@index([institutId])
  @@index([enseignantId])
}

// Invitation d'un membre de l'équipe : acceptée automatiquement à sa première
// connexion (e-mail identique), elle crée son accès avec le rôle choisi.
model Invitation {
  id                String           @id @default(cuid())
  institutId        String
  email             String
  role              Role
  enseignantId      String?
  clerkInvitationId String?
  statut            StatutInvitation @default(EN_ATTENTE)
  inviteParId       String?
  createdAt         DateTime         @default(now())
  accepteeLe        DateTime?

  institut   Institut    @relation(fields: [institutId], references: [id])
  enseignant Enseignant? @relation(fields: [enseignantId], references: [id])

  @@index([institutId, email])
}
